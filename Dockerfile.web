FROM python:3.12-slim
WORKDIR /app
COPY requirements-agentic.txt requirements.txt ./
# Pre-install CPU-only PyTorch wheel to prevent 2.5GB CUDA download and Render timeout/OOM
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements-agentic.txt
COPY . .
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "streamlit run app.py --server.address=0.0.0.0 --server.port=${PORT:-8080} --server.headless=true --server.enableCORS=false --server.enableXsrfProtection=false"]
