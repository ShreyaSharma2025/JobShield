# Copy this file to .env. Never commit your actual API keys.
# Provide your Google Gemini API Key from https://aistudio.google.com
GOOGLE_API_KEY=
BRAVE_SEARCH_API_KEY=

# Agent Execution Toggle
CREWAI_AGENT_ENABLED=true
CREWAI_MODEL=gemini/gemini-2.5-flash
ADK_MODEL=gemini-2.5-flash
A2A_AGENT_ENABLED=false
A2A_AGENT_URL=http://127.0.0.1:8001
A2A_ADVERTISED_HOST=127.0.0.1
A2A_ADVERTISED_PORT=8001
A2A_PROTOCOL=http
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
